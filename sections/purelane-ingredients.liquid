<section class="sec" id="ingredients" data-scene="2">
  <div class="wrap">
    <div class="glass sec-pad rv">
      {% render 'purelane-section-heading', heading: section.settings.heading %}
      <div class="ing">
        {%- for block in section.blocks -%}
          <div class="ing-i" {{ block.shopify_attributes }}>
            <div class="art">{% render 'purelane-icon', name: block.settings.icon %}</div>
            <h4>{{ block.settings.title | escape }}</h4>
            <p>{{ block.settings.body | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane ingredients",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sourced from nature" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Coconut" },
        { "type": "text", "id": "body", "label": "Body", "default": "Plant-derived cleansers that lift grease" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "coconut", "options": [
          { "value": "coconut", "label": "Coconut" },
          { "value": "orange", "label": "Orange peel" },
          { "value": "soapnut", "label": "Soap nut" },
          { "value": "neem", "label": "Neem" },
          { "value": "lemongrass", "label": "Lemongrass" }
        ] }
      ]
    }
  ],
  "presets": [
    { "name": "Purelane ingredients" }
  ]
}
{% endschema %}
