<footer data-scene="4">
  <div class="wrap">
    <div class="fgrid">
      <div class="fcol">
        <a class="brand" href="#top" style="margin-bottom:16px">
          <span class="mark">{% render 'purelane-icon', name: 'leaf' %}</span>
          <span class="txt"><span class="n1">{{ section.settings.brand_name | escape }}</span><span class="n2">{{ section.settings.brand_tagline | escape }}</span></span>
        </a>
        <p style="max-width:30ch">{{ section.settings.body | escape }}</p>
      </div>
      <div class="fcol">
        <h5>Shop</h5>
        <a href="#shop">Bestsellers</a>
        <a href="#shop">Kitchen</a>
        <a href="#shop">Laundry</a>
        <a href="#shop">Home</a>
        <a href="#shop">Skin</a>
        <a href="#bundles">Starter kits</a>
      </div>
      <div class="fcol">
        <h5>About</h5>
        <a href="#how">How it works</a>
        <a href="#ingredients">Sustainability</a>
        <a href="#proof">FAQs</a>
        <a href="#reviews">Reviews</a>
      </div>
      <div class="fcol">
        <h5>Get in touch</h5>
        <a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
        <a href="tel:{{ section.settings.phone | replace: ' ', '' | escape }}">{{ section.settings.phone | escape }}</a>
        <p style="font-size:12px;color:rgba(36,26,61,.5)">{{ section.settings.company | escape }}</p>
      </div>
    </div>
    <div class="fbot">
      <span>{{ section.settings.copyright | escape }}</span>
      <span>{{ section.settings.legal | escape }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Purelane footer",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Purelane" },
    { "type": "text", "id": "brand_tagline", "label": "Brand tagline", "default": "Clean, simply" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Effective cleaning, powered by nature. Made for Indian homes since day one." },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@purelane.com" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+91 9930 123 234" },
    { "type": "text", "id": "company", "label": "Company", "default": "Purelane Eco Products Pvt Ltd" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© 2026 Purelane Eco Products Private Limited" },
    { "type": "text", "id": "legal", "label": "Legal text", "default": "Privacy · Terms · Refunds · Contact" }
  ],
  "presets": [
    { "name": "Purelane footer" }
  ]
}
{% endschema %}
