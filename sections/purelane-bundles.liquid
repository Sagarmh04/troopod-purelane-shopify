{%- liquid
  assign collection = section.settings.collection
-%}
<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        {%- if section.settings.kicker != blank -%}
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
        {%- endif -%}
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.body != blank -%}
          <p class="lede" style="margin:0 auto">{{ section.settings.body | escape }}</p>
        {%- endif -%}
      </div>
    </div>
    <div class="tiers">
      {%- for block in section.blocks -%}
        {%- assign fallback_product_1 = collection.products[0] -%}
        {%- assign fallback_product_2 = collection.products[1] -%}
        {%- assign fallback_product_3 = collection.products[2] -%}
        {%- assign fallback_product_4 = collection.products[3] -%}
        {%- assign fallback_product_5 = collection.products[4] -%}
        {%- assign selected_product_1 = block.settings.product_1 | default: fallback_product_1 -%}
        {%- assign selected_product_2 = block.settings.product_2 | default: fallback_product_2 -%}
        {%- assign selected_product_3 = block.settings.product_3 | default: fallback_product_3 -%}
        {%- assign selected_product_4 = block.settings.product_4 | default: fallback_product_4 -%}
        {%- assign selected_product_5 = block.settings.product_5 | default: fallback_product_5 -%}
        {% render 'purelane-bundle-tier',
          block: block,
          product_1: selected_product_1,
          product_2: selected_product_2,
          product_3: selected_product_3,
          product_4: selected_product_4,
          product_5: selected_product_5
        %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane bundles",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "product", "id": "product_3", "label": "Product 3" },
        { "type": "product", "id": "product_4", "label": "Product 4" },
        { "type": "product", "id": "product_5", "label": "Product 5" },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Starter" },
        { "type": "range", "id": "quantity", "label": "Quantity", "min": 2, "max": 5, "step": 1, "default": 2 },
        { "type": "text", "id": "body", "label": "Body", "default": "Pick any two products" },
        { "type": "text", "id": "benefit_1", "label": "Benefit 1", "default": "Pick any two products" },
        { "type": "text", "id": "benefit_2", "label": "Benefit 2", "default": "Free shipping across India" },
        { "type": "text", "id": "benefit_3", "label": "Benefit 3" },
        { "type": "text", "id": "label", "label": "Button label", "default": "Build this box" },
        { "type": "url", "id": "link", "label": "Button link" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "Purelane bundles" }
  ]
}
{% endschema %}
