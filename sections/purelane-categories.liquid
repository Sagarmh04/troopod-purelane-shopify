{%- assign collection = section.settings.collection -%}
<section class="sec" id="categories" data-scene="4">
  <div class="wrap">
    {% render 'purelane-section-heading', kicker: section.settings.kicker, heading: section.settings.heading, show_rule: false, class_name: 'panel-head rv' %}
    <div class="cats">
      {%- for block in section.blocks -%}
        {%- assign fallback_product = collection.products[forloop.index0] -%}
        <a class="glass cat rv{% if forloop.index > 1 %} rv-d{{ forloop.index0 }}{% endif %}" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
          <span class="ph">
            {% render 'purelane-product-figure', product: fallback_product, class_name: 'pimg', sizes: '(min-width: 1024px) 140px, 32vw', widths: '120, 180, 240, 320', decorative: true %}
          </span>
          <span class="txt"><h4>{{ block.settings.title | escape }}</h4><p>{{ block.settings.body | escape }}</p></span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane categories",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bundle categories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right bundle for you" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen bundle" },
        { "type": "text", "id": "body", "label": "Body", "default": "Grease, dishes & more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Purelane categories" }
  ]
}
{% endschema %}
