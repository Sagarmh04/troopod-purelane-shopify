<section class="sec" id="whybundles" data-scene="4">
  <div class="wrap">
    <div class="glass sec-pad rv">
      {% render 'purelane-section-heading', kicker: section.settings.kicker, heading: section.settings.heading, show_rule: false %}
      <div class="wb">
        {%- for block in section.blocks -%}
          <div class="wb-i" {{ block.shopify_attributes }}>
            <span class="ci">{% render 'purelane-icon', name: block.settings.icon %}</span>
            <h4>{{ block.settings.title | escape }}</h4>
            <p>{{ block.settings.body | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane why bundles",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The smarter way to shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why bundles beat buying single" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Save up to 45%" },
        { "type": "text", "id": "body", "label": "Body", "default": "Versus buying the same products separately" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "money", "options": [
          { "value": "money", "label": "Money" },
          { "value": "box-check", "label": "Box check" },
          { "value": "star", "label": "Star" },
          { "value": "truck", "label": "Truck" }
        ] }
      ]
    }
  ],
  "presets": [
    { "name": "Purelane why bundles" }
  ]
}
{% endschema %}
