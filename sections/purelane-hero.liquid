{%- liquid
  assign collection = section.settings.collection
  assign product_1 = collection.products[0]
  assign product_2 = collection.products[1]
  assign product_3 = collection.products[2]
  assign price_1 = 0
  assign compare_1 = 0
  assign price_2 = 0
  assign compare_2 = 0
  assign price_3 = 0
  assign compare_3 = 0
  assign savings_1_percentage = 0

  if product_1 != blank
    assign variant_1 = product_1.selected_or_first_available_variant
    assign price_1 = variant_1.price
    if variant_1.compare_at_price > variant_1.price
      assign compare_1 = variant_1.compare_at_price
      assign savings_1_percentage = compare_1 | minus: price_1 | times: 100.0 | divided_by: compare_1 | round
    else
      assign compare_1 = variant_1.price
    endif
  endif
  if product_2 != blank
    assign variant_2 = product_2.selected_or_first_available_variant
    assign price_2 = price_1 | plus: variant_2.price
    assign compare_2 = compare_1
    if variant_2.compare_at_price > variant_2.price
      assign compare_2 = compare_2 | plus: variant_2.compare_at_price
    else
      assign compare_2 = compare_2 | plus: variant_2.price
    endif
  endif
  if product_3 != blank
    assign variant_3 = product_3.selected_or_first_available_variant
    assign price_3 = price_2 | plus: variant_3.price
    assign compare_3 = compare_2
    if variant_3.compare_at_price > variant_3.price
      assign compare_3 = compare_3 | plus: variant_3.compare_at_price
    else
      assign compare_3 = compare_3 | plus: variant_3.price
    endif
  endif
-%}

<section id="top" class="hero" data-scene="1" data-purelane-controller="hero" data-section-id="{{ section.id }}" data-purelane-hero>
  <div class="hero-grid">
    <div class="badges glass-2" aria-label="Product promises">
      <div class="badge"><span class="bi">{% render 'purelane-icon', name: 'leaf' %}</span><span>Plant<br>powered</span></div>
      <div class="badge"><span class="bi">{% render 'purelane-icon', name: 'shield' %}</span><span>Safe for<br>kids & pets</span></div>
      <div class="badge"><span class="bi">{% render 'purelane-icon', name: 'no-harsh' %}</span><span>Zero harsh<br>chemicals</span></div>
    </div>

    <div class="hero-copy">
      <h1 class="d1 rv in">{{ section.settings.title_line_1 | escape }}<br>{{ section.settings.title_line_2 | escape }}<br><span class="lime">{{ section.settings.title_accent | escape }}</span></h1>
      <div class="rule rv rv-d1"><i></i>{% render 'purelane-icon', name: 'leaf' %}<i></i></div>
      <p class="lede rv rv-d2">{{ section.settings.body | escape }}</p>
      <div class="hero-cta rv rv-d3">
        <a class="btn btn-primary" href="{{ section.settings.primary_link | default: '#shop' }}">{{ section.settings.primary_label | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"></path></svg></a>
        <a class="btn btn-ghost" href="{{ section.settings.secondary_link | default: '#how' }}">{{ section.settings.secondary_label | escape }}</a>
      </div>
      <div class="badgestrip rv rv-d4">
        <div class="glass-2">{% render 'purelane-icon', name: 'leaf' %}Plant powered</div>
        <div class="glass-2">{% render 'purelane-icon', name: 'shield' %}Safe for kids &amp; pets</div>
        <div class="glass-2">{% render 'purelane-icon', name: 'no-harsh' %}Zero harsh chemicals</div>
      </div>
    </div>

    <div class="hero-prod" data-purelane-hero-product>
      <div class="hstage" data-purelane-hero-stage>
        <div class="hslide hs1 on">
          {% render 'purelane-product-figure', product: product_1, class_name: 'hp a', sizes: '(min-width: 990px) 320px, 48vw', widths: '240, 320, 420, 520', decorative: true, loading: 'eager' %}
          <div class="glass-2 ptag">
            <span class="lbl">Single bottle</span>
            <span class="val"><strong>{{ price_1 | money }}</strong>{% if compare_1 > price_1 %}<s>{{ compare_1 | money }}</s>{% endif %}</span>
            {%- if compare_1 > price_1 -%}<span class="cut">{{ savings_1_percentage }}% off</span>{%- endif -%}
          </div>
        </div>
        <div class="hslide hs2">
          {% render 'purelane-product-figure', product: product_2, class_name: 'hp a', sizes: '(min-width: 990px) 260px, 38vw', widths: '240, 320, 420', decorative: true %}
          {% render 'purelane-product-figure', product: product_1, class_name: 'hp b', sizes: '(min-width: 990px) 320px, 48vw', widths: '240, 320, 420, 520', decorative: true %}
          <div class="glass-2 ptag">
            <span class="lbl">Any 2 products</span>
            <span class="val"><strong>{{ price_2 | money }}</strong>{% if compare_2 > price_2 %}<s>{{ compare_2 | money }}</s>{% endif %}</span>
            {%- if compare_2 > price_2 -%}<span class="cut">Save {{ compare_2 | minus: price_2 | money }}</span>{%- endif -%}
          </div>
        </div>
        <div class="hslide hs3">
          {% render 'purelane-product-figure', product: product_2, class_name: 'hp a', sizes: '(min-width: 990px) 220px, 32vw', widths: '180, 240, 320, 420', decorative: true %}
          {% render 'purelane-product-figure', product: product_3, class_name: 'hp b', sizes: '(min-width: 990px) 320px, 42vw', widths: '240, 320, 420, 520', decorative: true %}
          {% render 'purelane-product-figure', product: product_1, class_name: 'hp c', sizes: '(min-width: 990px) 220px, 28vw', widths: '180, 240, 320, 420', decorative: true %}
          <div class="glass-2 ptag">
            <span class="lbl">Any 3 products</span>
            <span class="val"><strong>{{ price_3 | money }}</strong>{% if compare_3 > price_3 %}<s>{{ compare_3 | money }}</s>{% endif %}</span>
            {%- if compare_3 > price_3 -%}<span class="cut">Save {{ compare_3 | minus: price_3 | money }}</span>{%- endif -%}
          </div>
        </div>
      </div>
      <div class="hdots">
        <button type="button" class="on" aria-label="Show 1 product"></button>
        <button type="button" aria-label="Show 2 products"></button>
        <button type="button" aria-label="Show 3 products"></button>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "title_line_1", "label": "Title line 1", "default": "Clean" },
    { "type": "text", "id": "title_line_2", "label": "Title line 2", "default": "That" },
    { "type": "text", "id": "title_accent", "label": "Accent line", "default": "Lasts" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop now" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "How it works" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
  ],
  "presets": [
    { "name": "Purelane hero" }
  ]
}
{% endschema %}
