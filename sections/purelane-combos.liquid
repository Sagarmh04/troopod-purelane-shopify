{%- liquid
  assign collection = section.settings.collection
-%}
<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    {% render 'purelane-section-heading', kicker: section.settings.kicker, heading: section.settings.heading, body: section.settings.body, class_name: 'panel-head rv' %}
    <div class="comborail rv">
      {%- for block in section.blocks -%}
        {%- assign fallback_product_1 = blank -%}
        {%- assign fallback_product_2 = blank -%}
        {%- assign fallback_product_3 = blank -%}
        {%- case forloop.index -%}
          {%- when 1 -%}
            {%- assign fallback_product_1 = collection.products[0] -%}
            {%- assign fallback_product_2 = collection.products[1] -%}
            {%- assign fallback_product_3 = collection.products[2] -%}
          {%- when 2 -%}
            {%- assign fallback_product_1 = collection.products[2] -%}
            {%- assign fallback_product_2 = collection.products[3] -%}
            {%- assign fallback_product_3 = collection.products[4] -%}
          {%- when 3 -%}
            {%- assign fallback_product_1 = collection.products[0] -%}
            {%- assign fallback_product_2 = collection.products[3] -%}
            {%- assign fallback_product_3 = collection.products[5] -%}
          {%- when 4 -%}
            {%- assign fallback_product_1 = collection.products[4] -%}
            {%- assign fallback_product_2 = collection.products[1] -%}
            {%- assign fallback_product_3 = collection.products[6] -%}
          {%- else -%}
            {%- assign fallback_product_1 = collection.products[1] -%}
            {%- assign fallback_product_2 = collection.products[4] -%}
        {%- endcase -%}
        {%- assign product_a = block.settings.product_1 | default: fallback_product_1 -%}
        {%- assign product_b = block.settings.product_2 | default: fallback_product_2 -%}
        {%- assign product_c = block.settings.product_3 | default: fallback_product_3 -%}
        {% render 'purelane-combo-card', block: block, product_a: product_a, product_b: product_b, product_c: product_c %}
      {%- endfor -%}
    </div>
    <div class="swipecue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"></path></svg>Swipe for more combos</div>
    <p class="railnote">{{ section.settings.rail_note | escape }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "textarea", "id": "rail_note", "label": "Rail note", "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay." }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "select", "id": "item_visual_1", "label": "Product 1 visual", "default": "product", "options": [
          { "value": "product", "label": "Product" },
          { "value": "tile_leaf", "label": "Leaf tile" }
        ] },
        { "type": "text", "id": "item_copy_1", "label": "Product 1 copy", "default": "Cleans beautifully" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "select", "id": "item_visual_2", "label": "Product 2 visual", "default": "product", "options": [
          { "value": "product", "label": "Product" },
          { "value": "tile_leaf", "label": "Leaf tile" }
        ] },
        { "type": "text", "id": "item_copy_2", "label": "Product 2 copy", "default": "Loved by Indian homes" },
        { "type": "product", "id": "product_3", "label": "Product 3" },
        { "type": "select", "id": "item_visual_3", "label": "Product 3 visual", "default": "product", "options": [
          { "value": "product", "label": "Product" },
          { "value": "tile_leaf", "label": "Leaf tile" }
        ] },
        { "type": "text", "id": "item_copy_3", "label": "Product 3 copy", "default": "Works on tough messes" },
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen essentials" },
        { "type": "text", "id": "count_label", "label": "Count label", "default": "3 products" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner. Everything for a sparkling kitchen, no need to pick separately." },
        { "type": "text", "id": "save_label", "label": "Save label override" },
        { "type": "text", "id": "flag", "label": "Flag", "default": "Most popular" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop bundle" },
        { "type": "url", "id": "cta_link", "label": "CTA link" },
        { "type": "checkbox", "id": "highlight", "label": "Highlight card", "default": false }
      ]
    }
  ],
  "presets": [
    { "name": "Purelane combos" }
  ]
}
{% endschema %}
