{%- liquid
  assign collection = section.settings.collection
-%}
<section class="sec" id="proof" data-scene="3" data-purelane-controller="proof" data-section-id="{{ section.id }}">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        <div class="proof-l">
          <span class="kicker">{{ section.settings.kicker | escape }}</span>
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape | newline_to_br | replace: '|', '<br>' }}</h2>
          <p class="body-s" style="max-width:40ch">{{ section.settings.body | escape }}</p>
          <a class="btn btn-primary" href="{{ section.settings.button_link | default: '#ingredients' }}">{{ section.settings.button_label | escape }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6"></path></svg></a>
        </div>
        <div class="glass-2 rot" data-purelane-proof-rotator aria-hidden="true">
          <div class="frame">
            {%- for product in collection.products limit: 6 -%}
              {%- assign frame_class = 'pimg' -%}
              {%- if forloop.first -%}
                {%- assign frame_class = 'pimg on' -%}
              {%- endif -%}
              {%- capture rotator_attrs -%}data-purelane-rotator-item data-name="{{ product.title | escape }}" data-note="{{ product.metafields.custom.purelane_badge_label.value | default: 'Plant-powered cleaning' | escape }}"{%- endcapture -%}
              {% render 'purelane-product-figure', product: product, class_name: frame_class, sizes: '(min-width: 1024px) 320px, 68vw', widths: '240, 320, 420, 520', decorative: true, extra_attrs: rotator_attrs %}
            {%- endfor -%}
          </div>
          <div class="cap"><b data-purelane-rotator-title>{{ collection.products[0].title | escape }}</b><span data-purelane-rotator-body>{{ collection.products[0].metafields.custom.purelane_badge_label.value | default: 'Plant-powered cleaning' | escape }}</span></div>
          <div class="dots">{%- for product in collection.products limit: 6 -%}<i{% if forloop.first %} class="on"{% endif %}></i>{%- endfor -%}</div>
        </div>
        <div class="glass-2 stats proof-stats" style="grid-column:1/-1">
          {%- for block in section.blocks -%}
            <div class="stat" {{ block.shopify_attributes }}>
              <div class="ring">{{ block.settings.value | escape }}</div>
              <h5>{{ block.settings.title | escape }}</h5>
              <p>{{ block.settings.body | escape }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane proof",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why it works" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Tough on grime.|Gentle on everything else." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See the ingredient list" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "99.9%" },
        { "type": "text", "id": "title", "label": "Title", "default": "Germ kill" },
        { "type": "text", "id": "body", "label": "Body", "default": "Tested against germs and bacteria" }
      ]
    }
  ],
  "presets": [
    { "name": "Purelane proof" }
  ]
}
{% endschema %}
